<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DongleDoctor.App.ViewModels"
             xmlns:v="using:DongleDoctor.App.Views"
             x:Class="DongleDoctor.App.Views.ScanningView"
             x:DataType="vm:ScanningViewModel">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="8">
            <TextBlock Classes="h" Text="Scanning" />
            <TextBlock Classes="sub" Text="Keep playing normally. You can take the headset off when you hear the chime." />
        </StackPanel>

        <Button DockPanel.Dock="Bottom" Classes="ghost" HorizontalAlignment="Center" Content="Stop early"
                Command="{Binding StopEarlyCommand}" />

        <StackPanel VerticalAlignment="Center" Spacing="14">
            <TextBlock Text="{Binding Hiccups}" FontSize="56" FontWeight="ExtraBold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource DdInkBrush}" />
            <TextBlock Classes="sub" Text="{Binding HiccupsLabel}" HorizontalAlignment="Center" Margin="0,-14,0,0" />

            <v:HiccupTimeline Height="22" Margin="0,10,0,0" Progress="{Binding Progress}" Marks="{Binding HiccupMarks}"
                              Track="{DynamicResource DdNeutralSoftBrush}" Fill="{DynamicResource DdAccentSoftBrush}"
                              Mark="{DynamicResource DdWarnBrush}" />
            <TextBlock Classes="small" HorizontalAlignment="Right" Text="{Binding TimeLeft}" Margin="0,-8,0,0" />

            <Border Classes="verdict away" IsVisible="{Binding ShowNoStreamWarning}">
                <StackPanel Spacing="2">
                    <TextBlock Text="No game stream detected" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource DdInkBrush}" />
                    <TextBlock Text="Start a game on your Frame. Only the time you're streaming counts." FontSize="12"
                               TextWrapping="Wrap" Foreground="{DynamicResource DdInk2Brush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>

</UserControl>
