<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DongleDoctor.App.ViewModels"
             x:Class="DongleDoctor.App.Views.WelcomeView"
             x:DataType="vm:WelcomeViewModel">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
        <Border Width="96" Height="96" CornerRadius="48" HorizontalAlignment="Center"
                Background="{DynamicResource DdAccentSoftBrush}">
            <TextBlock Text="+" FontSize="46" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource DdAccentBrush}" />
        </Border>
        <TextBlock Classes="h" TextAlignment="Center" Text="Let's get your Steam Frame streaming smoothly" />
        <TextBlock Classes="sub" TextAlignment="Center"
                   Text="We'll check how your dongle is plugged in, then watch your connection while you play for a few minutes." />
        <Button Classes="primary" HorizontalAlignment="Center" Content="Check my setup" Command="{Binding StartCommand}" />
        <TextBlock Classes="small" HorizontalAlignment="Center" Text="Takes about 5 minutes · Nothing changes unless you say so" />
    </StackPanel>

</UserControl>
