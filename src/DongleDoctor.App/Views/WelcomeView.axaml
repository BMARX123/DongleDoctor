<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DongleDoctor.App.ViewModels"
             x:Class="DongleDoctor.App.Views.WelcomeView"
             x:DataType="vm:WelcomeViewModel">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
        <Border Classes="hero accent"><TextBlock Text="+" /></Border>
        <TextBlock Classes="h" TextAlignment="Center" Text="Let's get your Steam Frame streaming smoothly" />
        <TextBlock Classes="sub" TextAlignment="Center"
                   Text="We'll check how your dongle is plugged in, then watch your connection while you play." />
        <Button Classes="primary big" HorizontalAlignment="Center" Content="Check my setup" Command="{Binding StartCommand}" />
        <TextBlock Classes="small" TextAlignment="Center" TextWrapping="Wrap"
                   Text="About 15 minutes, including 10 minutes of playing · Nothing changes unless you say so" />
    </StackPanel>

</UserControl>
