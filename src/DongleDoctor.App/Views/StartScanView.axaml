<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DongleDoctor.App.ViewModels"
             x:Class="DongleDoctor.App.Views.StartScanView"
             x:DataType="vm:StartScanViewModel">

    <DockPanel>
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto">
            <Button Classes="link" Content="Back" Command="{Binding BackCommand}" />
            <Button Grid.Column="2" Classes="primary big" Content="Start scan" Command="{Binding StartCommand}" />
        </Grid>

        <StackPanel Spacing="14">
            <TextBlock Classes="h" Text="Scan while you play" />
            <TextBlock Classes="sub"
                       Text="Start a game on your Frame first, then play normally. We'll count any hiccups while you play." />

            <StackPanel Spacing="6">
                <Border Classes="seg">
                    <ItemsControl ItemsSource="{Binding Options}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ScanLengthOption">
                                <Border BorderBrush="{DynamicResource DdLineBrush}" BorderThickness="0,0,1,0">
                                    <RadioButton Classes="seg" GroupName="ScanLength" IsChecked="{Binding IsSelected}"
                                                 AutomationProperties.Name="{Binding Name}">
                                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource DdInkBrush}" />
                                            <TextBlock Classes="small" Text="{Binding Length}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock Classes="small" TextWrapping="Wrap" Text="{Binding SelectedDetail}" />
            </StackPanel>

            <TextBlock Classes="small" TextWrapping="Wrap"
                       Text="Your PC's sound plays in the headset, so you'll hear a chime when the scan is done." />
        </StackPanel>
    </DockPanel>

</UserControl>
