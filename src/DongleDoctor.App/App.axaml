<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DongleDoctor.App.ViewModels"
             xmlns:v="using:DongleDoctor.App.Views"
             x:Class="DongleDoctor.App.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <DataTemplate DataType="vm:WelcomeViewModel"><v:WelcomeView /></DataTemplate>
        <DataTemplate DataType="vm:QuickChecksViewModel"><v:QuickChecksView /></DataTemplate>
        <DataTemplate DataType="vm:ResultViewModel"><v:ResultView /></DataTemplate>
        <DataTemplate DataType="vm:StartScanViewModel"><v:StartScanView /></DataTemplate>
        <DataTemplate DataType="vm:ScanningViewModel"><v:ScanningView /></DataTemplate>
        <DataTemplate DataType="vm:WifiViewModel"><v:WifiView /></DataTemplate>
    </Application.DataTemplates>

    <!-- Brand colours, light and dark. Accent #1A9FFF takes dark text: white on it is only 2.9:1 contrast. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DdWindowBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DdSheetBrush" Color="#F8FAFB" />
                    <SolidColorBrush x:Key="DdInkBrush" Color="#17232C" />
                    <SolidColorBrush x:Key="DdInk2Brush" Color="#4D5E6A" />
                    <SolidColorBrush x:Key="DdLineBrush" Color="#C9D3DA" />
                    <SolidColorBrush x:Key="DdAccentBrush" Color="#1A9FFF" />
                    <SolidColorBrush x:Key="DdAccentHoverBrush" Color="#4DB4FF" />
                    <SolidColorBrush x:Key="DdAccentTextBrush" Color="#0A69C2" />
                    <SolidColorBrush x:Key="DdAccentInkBrush" Color="#04203A" />
                    <SolidColorBrush x:Key="DdAccentSoftBrush" Color="#DCEFFF" />
                    <SolidColorBrush x:Key="DdGoodBrush" Color="#1F7A3F" />
                    <SolidColorBrush x:Key="DdGoodSoftBrush" Color="#DCEFE2" />
                    <SolidColorBrush x:Key="DdWarnBrush" Color="#A35F00" />
                    <SolidColorBrush x:Key="DdWarnSoftBrush" Color="#F7E7CC" />
                    <SolidColorBrush x:Key="DdCritBrush" Color="#B3261E" />
                    <SolidColorBrush x:Key="DdCritSoftBrush" Color="#F6DCD9" />
                    <SolidColorBrush x:Key="DdNeutralSoftBrush" Color="#E6ECEF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DdWindowBrush" Color="#1A252C" />
                    <SolidColorBrush x:Key="DdSheetBrush" Color="#141D23" />
                    <SolidColorBrush x:Key="DdInkBrush" Color="#E3EAEE" />
                    <SolidColorBrush x:Key="DdInk2Brush" Color="#9AABB6" />
                    <SolidColorBrush x:Key="DdLineBrush" Color="#2C3A43" />
                    <SolidColorBrush x:Key="DdAccentBrush" Color="#1A9FFF" />
                    <SolidColorBrush x:Key="DdAccentHoverBrush" Color="#4DB4FF" />
                    <SolidColorBrush x:Key="DdAccentTextBrush" Color="#5CB8FF" />
                    <SolidColorBrush x:Key="DdAccentInkBrush" Color="#04203A" />
                    <SolidColorBrush x:Key="DdAccentSoftBrush" Color="#10304D" />
                    <SolidColorBrush x:Key="DdGoodBrush" Color="#5FC47F" />
                    <SolidColorBrush x:Key="DdGoodSoftBrush" Color="#17331F" />
                    <SolidColorBrush x:Key="DdWarnBrush" Color="#E3A54A" />
                    <SolidColorBrush x:Key="DdWarnSoftBrush" Color="#3A2A12" />
                    <SolidColorBrush x:Key="DdCritBrush" Color="#F07A70" />
                    <SolidColorBrush x:Key="DdCritSoftBrush" Color="#3D1A17" />
                    <SolidColorBrush x:Key="DdNeutralSoftBrush" Color="#222F37" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Type: Bricolage Grotesque for headings, Atkinson Hyperlegible for text (the default), a system mono for numbers. -->
            <FontFamily x:Key="DdDisplayFont">avares://DongleDoctor/Assets/Fonts#Bricolage Grotesque</FontFamily>
            <FontFamily x:Key="DdBodyFont">avares://DongleDoctor/Assets/Fonts#Atkinson Hyperlegible</FontFamily>
            <FontFamily x:Key="DdMonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Text -->
        <Style Selector="TextBlock.h">
            <Setter Property="FontFamily" Value="{StaticResource DdDisplayFont}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="LineHeight" Value="28" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource DdInkBrush}" />
        </Style>
        <Style Selector="TextBlock.h.h2">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="LineHeight" Value="24" />
        </Style>
        <Style Selector="TextBlock.sub">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource DdInk2Brush}" />
        </Style>
        <Style Selector="TextBlock.small">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource DdInk2Brush}" />
        </Style>
        <Style Selector="TextBlock.t">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource DdInkBrush}" />
        </Style>
        <Style Selector="TextBlock.d">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource DdInk2Brush}" />
        </Style>

        <!-- Buttons. Footers follow one rule: the main button bottom-right, the secondary to its left, escape links far left. -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource DdAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DdAccentInkBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.primary.big">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="26,12" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DdAccentHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DdAccentInkBrush}" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DdAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DdAccentInkBrush}" />
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DdAccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DdAccentTextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DdAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DdAccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DdAccentTextBrush}" />
        </Style>
        <!-- An escape link (Back, Skip): text only, far left in the footer. -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,4" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource DdAccentTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DdAccentHoverBrush}" />
        </Style>
        <Style Selector="Button.ghost.compact">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Status icons on the Quick checks rows. -->
        <Style Selector="Border.ic">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource DdNeutralSoftBrush}" />
        </Style>
        <Style Selector="Border.ic TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource DdInk2Brush}" />
        </Style>
        <Style Selector="Border.ic.running"><Setter Property="Background" Value="Transparent" /></Style>
        <Style Selector="Arc.spin">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.ic.good"><Setter Property="Background" Value="{DynamicResource DdGoodSoftBrush}" /></Style>
        <Style Selector="Border.ic.good TextBlock"><Setter Property="Foreground" Value="{DynamicResource DdGoodBrush}" /></Style>
        <Style Selector="Border.ic.warn"><Setter Property="Background" Value="{DynamicResource DdWarnSoftBrush}" /></Style>
        <Style Selector="Border.ic.warn TextBlock"><Setter Property="Foreground" Value="{DynamicResource DdWarnBrush}" /></Style>
        <Style Selector="Border.ic.crit"><Setter Property="Background" Value="{DynamicResource DdCritSoftBrush}" /></Style>
        <Style Selector="Border.ic.crit TextBlock"><Setter Property="Foreground" Value="{DynamicResource DdCritBrush}" /></Style>

        <!-- The big round badge on Welcome, Ready and Stop streaming. -->
        <Style Selector="Border.hero">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="96" />
            <Setter Property="CornerRadius" Value="48" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.hero > TextBlock">
            <!-- Neither bundled font has a bold ✓, so the badge glyphs use Windows' symbol font. -->
            <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI" />
            <Setter Property="FontSize" Value="46" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.hero.sm">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="64" />
            <Setter Property="CornerRadius" Value="32" />
        </Style>
        <Style Selector="Border.hero.sm > TextBlock"><Setter Property="FontSize" Value="32" /></Style>
        <Style Selector="Border.hero.accent"><Setter Property="Background" Value="{DynamicResource DdAccentSoftBrush}" /></Style>
        <Style Selector="Border.hero.accent > TextBlock"><Setter Property="Foreground" Value="{DynamicResource DdAccentTextBrush}" /></Style>
        <Style Selector="Border.hero.good"><Setter Property="Background" Value="{DynamicResource DdGoodSoftBrush}" /></Style>
        <Style Selector="Border.hero.good > TextBlock"><Setter Property="Foreground" Value="{DynamicResource DdGoodBrush}" /></Style>
        <Style Selector="Border.hero.warn"><Setter Property="Background" Value="{DynamicResource DdWarnSoftBrush}" /></Style>
        <Style Selector="Border.hero.warn > TextBlock"><Setter Property="Foreground" Value="{DynamicResource DdWarnBrush}" /></Style>

        <!-- Verdict banners and their round badge. -->
        <Style Selector="Border.verdict">
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.verdict.slim"><Setter Property="Padding" Value="12,10" /></Style>
        <Style Selector="Border.verdict.bad"><Setter Property="Background" Value="{DynamicResource DdCritSoftBrush}" /></Style>
        <Style Selector="Border.verdict.away"><Setter Property="Background" Value="{DynamicResource DdWarnSoftBrush}" /></Style>
        <Style Selector="Border.verdict.ok"><Setter Property="Background" Value="{DynamicResource DdGoodSoftBrush}" /></Style>
        <Style Selector="Border.badge">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
        </Style>
        <Style Selector="Border.badge > TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DdDisplayFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource DdWindowBrush}" />
        </Style>
        <Style Selector="Border.bad Border.badge"><Setter Property="Background" Value="{DynamicResource DdCritBrush}" /></Style>
        <Style Selector="Border.away Border.badge"><Setter Property="Background" Value="{DynamicResource DdWarnBrush}" /></Style>

        <!-- One finding, with a severity stripe on the left and a text tag (so colour isn't the only signal). -->
        <Style Selector="Border.finding">
            <Setter Property="BorderBrush" Value="{DynamicResource DdLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.stripe"><Setter Property="Background" Value="{DynamicResource DdAccentTextBrush}" /></Style>
        <Style Selector="Border.stripe.crit"><Setter Property="Background" Value="{DynamicResource DdCritBrush}" /></Style>
        <Style Selector="Border.stripe.warn"><Setter Property="Background" Value="{DynamicResource DdWarnBrush}" /></Style>
        <Style Selector="Border.stripe.good"><Setter Property="Background" Value="{DynamicResource DdGoodBrush}" /></Style>

        <Style Selector="Border.tag">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Border.tag > TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DdMonoFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.5" />
        </Style>
        <Style Selector="Border.tag.warn"><Setter Property="Background" Value="{DynamicResource DdWarnSoftBrush}" /></Style>
        <Style Selector="Border.tag.warn > TextBlock"><Setter Property="Foreground" Value="{DynamicResource DdWarnBrush}" /></Style>
        <Style Selector="Border.tag.crit"><Setter Property="Background" Value="{DynamicResource DdCritSoftBrush}" /></Style>
        <Style Selector="Border.tag.crit > TextBlock"><Setter Property="Foreground" Value="{DynamicResource DdCritBrush}" /></Style>
        <Style Selector="TextBlock.pass">
            <Setter Property="FontFamily" Value="{StaticResource DdMonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DdGoodBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Stat tiles (Scanning, Ready). -->
        <Style Selector="Border.stat">
            <Setter Property="Background" Value="{DynamicResource DdSheetBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DdLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="TextBlock.k">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource DdInk2Brush}" />
        </Style>
        <Style Selector="TextBlock.v">
            <Setter Property="FontFamily" Value="{StaticResource DdMonoFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DdInkBrush}" />
        </Style>
        <Style Selector="TextBlock.v.word">
            <Setter Property="FontFamily" Value="{StaticResource DdBodyFont}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.timer">
            <Setter Property="FontFamily" Value="{StaticResource DdMonoFont}" />
            <Setter Property="FontSize" Value="44" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DdInkBrush}" />
        </Style>
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Ellipse.dot.good"><Setter Property="Fill" Value="{DynamicResource DdGoodBrush}" /></Style>
        <Style Selector="Ellipse.dot.warn"><Setter Property="Fill" Value="{DynamicResource DdWarnBrush}" /></Style>

        <!-- Segmented control: the scan length. The chosen segment takes the soft accent and an underline. -->
        <Style Selector="Border.seg">
            <Setter Property="BorderBrush" Value="{DynamicResource DdLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="RadioButton.seg">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Seg" Background="{TemplateBinding Background}" Padding="6,10">
                        <Panel>
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Name="Bar" Height="3" VerticalAlignment="Bottom" Margin="-6,0,-6,-10" IsVisible="False"
                                    Background="{DynamicResource DdAccentTextBrush}" />
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.seg:pointerover"><Setter Property="Background" Value="{DynamicResource DdSheetBrush}" /></Style>
        <Style Selector="RadioButton.seg:checked"><Setter Property="Background" Value="{DynamicResource DdAccentSoftBrush}" /></Style>
        <Style Selector="RadioButton.seg:checked /template/ Border#Bar"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="RadioButton.seg:focus-visible /template/ Border#Seg">
            <Setter Property="BorderBrush" Value="{DynamicResource DdAccentTextBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!-- "Technical details": plain words on screen, numbers behind this. -->
        <Style Selector="Expander.tech">
            <Setter Property="Padding" Value="0,6,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource DdAccentTextBrush}" />
        </Style>
    </Application.Styles>
</Application>
